# Container image name for financialmcp-api
FINANCIALMCP_API_IMAGE=

# Default container port for financialmcp-api
FINANCIALMCP_API_PORT=

# Bind mount source for financialmcp-postgres:/docker-entrypoint-initdb.d
FINANCIALMCP_POSTGRES_BINDMOUNT_0=

# Parameter financialmcp-postgres-password
FINANCIALMCP_POSTGRES_PASSWORD=

# Bind mount source for pgadmin:/pgadmin4/servers.json
PGADMIN_BINDMOUNT_0=

# Parameter pgadmin-email
PGADMIN_EMAIL=

# Parameter pgadmin-password
PGADMIN_PASSWORD=

